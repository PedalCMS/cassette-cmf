			},
			"context": {
				"x": "a"
			},
			"expected": false
		},
		{
			"name": "operator alias not",
			"conditional": {
				"field": "x",
				"operator": "not",
				"value": "a"
			},
			"context": {
				"x": "b"
			},
			"expected": true
		},
		{
			"name": "operator alias !==",
			"conditional": {
				"field": "x",
				"operator": "!==",
				"value": "a"
			},
			"context": {
				"x": "b"
			},
			"expected": true
