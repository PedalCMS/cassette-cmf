{
	"description": "Shared by tests/Unit/Test_Condition_Fixtures.php (PHP evaluator) and tests/js/conditions.test.js (JS evaluator). conditional is the raw field config; context is the submitted values by field name.",
	"cases": [
		{
			"name": "no conditional",
			"conditional": [],
			"context": {},
			"expected": true
		},
		{
			"name": "empty object",
			"conditional": {},
			"context": {
				"a": "1"
			},
			"expected": true
		},
		{
			"name": "rules missing",
			"conditional": {
				"relation": "AND"
			},
			"context": {},
			"expected": true
		},
		{
			"name": "rule without field",
			"conditional": {
				"rules": [
					{
						"operator": "==",
						"value": "x"
					}
				]
			},
			"context": {},
			"expected": true
		},
		{
			"name": "non-object rule ignored",
			"conditional": {
				"rules": [
					"junk",
					{
						"field": "a",
						"value": "1"
					}
				]
			},
			"context": {
				"a": "1"
			},
			"expected": true
		},
		{
			"name": "single rule match",
			"conditional": {
				"field": "mode",
				"operator": "==",
				"value": "advanced"
			},
			"context": {
				"mode": "advanced"
			},
			"expected": true
		},
		{
			"name": "single rule mismatch",
			"conditional": {
				"field": "mode",
				"operator": "==",
				"value": "advanced"
			},
			"context": {
				"mode": "basic"
			},
			"expected": false
		},
		{
			"name": "default operator is ==",
			"conditional": {
				"field": "mode",
				"value": "a"
			},
			"context": {
				"mode": "a"
			},
			"expected": true
		},
		{
			"name": "compare key is an alias of operator",
			"conditional": {
				"field": "n",
				"compare": ">",
				"value": 3
			},
			"context": {
				"n": "5"
			},
			"expected": true
		},
		{
			"name": "values key is an alias of value",
			"conditional": {
				"field": "mode",
				"operator": "in",
				"values": [
					"a",
					"b"
				]
			},
			"context": {
				"mode": "b"
			},
			"expected": true
		},
		{
			"name": "operator alias =",
			"conditional": {
				"field": "x",
				"operator": "=",
				"value": "a"
			},
			"context": {
				"x": "a"
			},
			"expected": true
		},
		{
			"name": "operator alias eq",
			"conditional": {
				"field": "x",
				"operator": "eq",
				"value": "a"
			},
			"context": {
				"x": "b"
			},
			"expected": false
		},
		{
			"name": "operator alias equals",
			"conditional": {
				"field": "x",
				"operator": "equals",
				"value": "a"
			},
			"context": {
				"x": "a"
			},
			"expected": true
		},
		{
			"name": "operator alias ===",
			"conditional": {
				"field": "x",
				"operator": "===",
				"value": "a"
			},
			"context": {
				"x": "a"
			},
			"expected": true
		},
		{
			"name": "operator alias neq",
			"conditional": {
				"field": "x",
