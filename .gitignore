# Ignore Composer dependencies
/vendor/

# Ignore node modules
/node_modules/

# Ignore build artifacts
/dist/
.cache/

# build/ (the React settings app) IS committed and ships in the package.
# Playwright output
/test-results/
/playwright-report/

# Ignore logs and temp files
*.log
*.tmp

# Ignore OS generated files
.DS_Store
Thumbs.db

# Ignore IDE/project files
.vscode/

# Ignore WordPress specific files (if not needed in repo)
wp-config.php
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/

# Ignore environment files
.env
.env.*

# Ignore composer test artifacts
/.phpunit.result.cache

# Ignore coverage reports
/coverage/

# Playwright output (wp-scripts test-playwright)
artifacts/
